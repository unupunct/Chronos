<Window x:Class="Chronos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chronos"
        xmlns:vm="clr-namespace:Chronos.ViewModels"
        Title="Chronos - Windows Timeline"
        Width="1380" Height="860" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:EqualsVisibilityConverter x:Key="ViewVis"/>
        <local:EqualsBoolConverter x:Key="ViewBool"/>
        <local:SeverityBrushConverter x:Key="SevBrush"/>
        <local:CountVisibilityConverter x:Key="CountVis"/>
        <local:EventCountConverter x:Key="EventCount"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ================================ title bar ================================ -->
        <Grid Grid.Row="0" Background="{StaticResource Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Chronos" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                <TextBlock Text="Windows Timeline" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,1,0,0"/>
            </StackPanel>

            <!-- search -->
            <Border Grid.Column="1" MaxWidth="420" Margin="24,7" CornerRadius="6"
                    Background="{StaticResource Card}" BorderThickness="1"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="30,0,26,0" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource FgDim}"
                               Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBlock Text="Search: Chrome, USB, Blue Screen, yesterday..."
                               Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearch}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" Width="22" Height="22" Margin="0,0,4,0"
                            Padding="0" BorderThickness="0" Background="Transparent"
                            Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                            Visibility="{Binding HasSearch, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"
                                   Foreground="{StaticResource FgDim}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- toolbar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,7,8,7"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh timeline" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock Text="Refresh" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="ExportToggle" ToolTip="Export report" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock Text="Export" Margin="7,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=ExportToggle}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=ExportToggle}" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="Slide">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="6" MinWidth="170">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button Content="PDF report" Command="{Binding ExportCommand}" CommandParameter="pdf" Click="CloseExportPopup"/>
                            <Button Content="HTML report" Command="{Binding ExportCommand}" CommandParameter="html" Click="CloseExportPopup"/>
                            <Button Content="JSON data" Command="{Binding ExportCommand}" CommandParameter="json" Click="CloseExportPopup"/>
                            <Button Content="CSV spreadsheet" Command="{Binding ExportCommand}" CommandParameter="csv" Click="CloseExportPopup"/>
                            <Button Content="Markdown" Command="{Binding ExportCommand}" CommandParameter="md" Click="CloseExportPopup"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- caption buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- ================================ content ================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ~~~~ sidebar ~~~~ -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,20">

                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource ViewBool}, ConverterParameter=timeline, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="timeline" AutomationProperties.Name="Timeline">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Timeline" Margin="10,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource ViewBool}, ConverterParameter=stats, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="stats" AutomationProperties.Name="Statistics">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EF;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Statistics" Margin="10,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource ViewBool}, ConverterParameter=insights, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="insights" AutomationProperties.Name="Insights">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Insights" Margin="10,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource ViewBool}, ConverterParameter=dumps, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="dumps" AutomationProperties.Name="Crash Dumps">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="Crash Dumps" Margin="10,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     IsChecked="{Binding CurrentView, Converter={StaticResource ViewBool}, ConverterParameter=system, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="system" AutomationProperties.Name="System Info">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}"/>
                                <TextBlock Text="System Info" Margin="10,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Separator Margin="0,14,0,10" Background="{StaticResource Stroke}"/>

                        <TextBlock Text="TIME RANGE" Style="{StaticResource Dim}" FontSize="10.5" Margin="4,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}"/>

                        <StackPanel Visibility="{Binding IsCustomRange, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                            <DatePicker SelectedDate="{Binding CustomFrom}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding CustomTo}"/>
                        </StackPanel>

                        <TextBlock Text="ZOOM" Style="{StaticResource Dim}" FontSize="10.5" Margin="4,14,0,6"/>
                        <ComboBox ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding SelectedZoom}"/>

                        <TextBlock Text="QUICK FILTERS" Style="{StaticResource Dim}" FontSize="10.5" Margin="4,16,0,6"/>
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                    <Setter Property="Padding" Value="9,4"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="All" Command="{Binding QuickFilterCommand}" CommandParameter="all"/>
                            <Button Content="Only Errors" Command="{Binding QuickFilterCommand}" CommandParameter="errors"/>
                            <Button Content="Installations" Command="{Binding QuickFilterCommand}" CommandParameter="installs"/>
                            <Button Content="Hardware" Command="{Binding QuickFilterCommand}" CommandParameter="hardware"/>
                            <Button Content="Updates" Command="{Binding QuickFilterCommand}" CommandParameter="updates"/>
                        </WrapPanel>

                        <Grid Margin="4,12,0,6">
                            <TextBlock Text="CATEGORIES" Style="{StaticResource Dim}" FontSize="10.5"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="4,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="12" Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Margin="7,0,0,0" FontSize="12.5"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="SEVERITY" Style="{StaticResource Dim}" FontSize="10.5" Margin="4,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding Severities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="4,3">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ~~~~ center views ~~~~ -->
            <Grid Grid.Column="1">

                <!-- ============ TIMELINE ============ -->
                <Grid Style="{StaticResource ViewRoot}"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVis}, ConverterParameter=timeline}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <ListBox ItemsSource="{Binding TimelineView}" Background="Transparent" BorderThickness="0"
                             SelectedItem="{Binding SelectedEvent}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Padding="16,10,10,10">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,16,0,8">
                                            <Border Background="{StaticResource AccentDim}" CornerRadius="12" Padding="12,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{StaticResource Accent}"/>
                                            </Border>
                                            <TextBlock Text="{Binding ItemCount, Converter={StaticResource EventCount}}"
                                                       Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="card" Background="{StaticResource Card}"
                                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,9" Margin="24,0,6,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Dim}"
                                               FontFamily="Consolas" VerticalAlignment="Top" Margin="0,3,0,0"/>

                                    <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource Panel}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{Binding CategoryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="10,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding SeverityBrush}" Margin="0,1,7,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="#20FFFFFF" CornerRadius="9" Padding="7,1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10.5"
                                                           Foreground="{Binding CategoryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}"
                                                   TextWrapping="Wrap" Margin="14,3,0,0"/>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="3" IsChecked="{Binding IsExpanded}"
                                                  Background="Transparent" BorderThickness="0" Padding="6,4"
                                                  VerticalAlignment="Top" ToolTip="Details">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Foreground="{StaticResource FgDim}"/>
                                    </ToggleButton>

                                    <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="14,8,8,2"
                                            Background="#12FFFFFF" CornerRadius="6" Padding="12,8"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                        <ItemsControl ItemsSource="{Binding Details}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Dim}" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="34"
                                   Foreground="{StaticResource FgFaint}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No events match the current search and filters."
                                   Style="{StaticResource Dim}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a wider time range or press All."
                                   Style="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- right information panel -->
                    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="Event details" Style="{StaticResource H2}"/>

                                <TextBlock Text="Select an event on the timeline to inspect it."
                                           TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel DataContext="{Binding SelectedEvent}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Card}">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{Binding CategoryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryName}" Foreground="{Binding CategoryBrush}"
                                                       FontSize="11.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Model.Timestamp, StringFormat='dddd, dd MMMM yyyy  HH:mm:ss'}"
                                                       Style="{StaticResource Dim}" FontSize="11.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Separator Margin="0,12" Background="{StaticResource Stroke}"/>
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Dim}" FontSize="10.5"/>
                                                    <TextBlock Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Separator Margin="0,16,0,10" Background="{StaticResource Stroke}"
                                           Visibility="{Binding Warnings.Count, Converter={StaticResource CountVis}}"/>
                                <StackPanel Visibility="{Binding Warnings.Count, Converter={StaticResource CountVis}}">
                                    <TextBlock Text="Collection notes" Style="{StaticResource H2}" Foreground="{StaticResource Warn}"/>
                                    <ItemsControl ItemsSource="{Binding Warnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12"
                                                               Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                                               Margin="8,0,0,0" MaxWidth="240"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ STATISTICS ============ -->
                <Grid Style="{StaticResource ViewRoot}"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVis}, ConverterParameter=stats}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
                        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                            <TextBlock Text="Statistics" Style="{StaticResource H1}" Margin="0,4,0,14"/>

                            <ItemsControl ItemsSource="{Binding Stats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Width="205" Margin="0,0,12,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" Foreground="{StaticResource Accent}"/>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Dim}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Accent}" Margin="0,6,0,2"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Events by category" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding CategoryChart}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" FontSize="12"/>
                                                        <Grid Grid.Column="1" x:Name="track" VerticalAlignment="Center" Height="10">
                                                            <Border Background="#18FFFFFF" CornerRadius="5"/>
                                                            <Border Background="{Binding Brush}" CornerRadius="5"
                                                                    HorizontalAlignment="Left" Opacity="0.85">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{x:Static local:MainWindow.FractionWidth}">
                                                                        <Binding Path="Fraction"/>
                                                                        <Binding Path="ActualWidth" ElementName="track"/>
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12"
                                                                   HorizontalAlignment="Right" FontFamily="Consolas"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Activity (last 14 days)" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding ActivityChart}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" FontSize="11.5"/>
                                                        <Grid Grid.Column="1" x:Name="track2" VerticalAlignment="Center" Height="9">
                                                            <Border Background="#18FFFFFF" CornerRadius="5"/>
                                                            <Border Background="{Binding Brush}" CornerRadius="5"
                                                                    HorizontalAlignment="Left" Opacity="0.85">
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{x:Static local:MainWindow.FractionWidth}">
                                                                        <Binding Path="Fraction"/>
                                                                        <Binding Path="ActualWidth" ElementName="track2"/>
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11.5"
                                                                   HorizontalAlignment="Right" FontFamily="Consolas"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,20"
                                    Visibility="{Binding TopErrors.Count, Converter={StaticResource CountVis}}">
                                <StackPanel>
                                    <TextBlock Text="Most frequent errors" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding TopErrors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="320"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Grid Grid.Column="1" x:Name="track3" VerticalAlignment="Center" Height="10">
                                                        <Border Background="#18FFFFFF" CornerRadius="5"/>
                                                        <Border Background="{Binding Brush}" CornerRadius="5"
                                                                HorizontalAlignment="Left" Opacity="0.85">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{x:Static local:MainWindow.FractionWidth}">
                                                                    <Binding Path="Fraction"/>
                                                                    <Binding Path="ActualWidth" ElementName="track3"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12"
                                                               HorizontalAlignment="Right" FontFamily="Consolas"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ INSIGHTS ============ -->
                <Grid Style="{StaticResource ViewRoot}"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVis}, ConverterParameter=insights}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Insights &amp; Recommendations" Style="{StaticResource H1}" Margin="0,4,0,14"/>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="Summary" Style="{StaticResource H2}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Insights}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               FontSize="13.5" LineHeight="22"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Recommendations" Style="{StaticResource H2}" Margin="0,18,0,8"/>
                            <ItemsControl ItemsSource="{Binding Recommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" CornerRadius="2" Margin="0,2,12,2"
                                                        Background="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
                                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Dim}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ SYSTEM INFO ============ -->
                <Grid Style="{StaticResource ViewRoot}"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVis}, ConverterParameter=system}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="Computer Information" Style="{StaticResource H1}" Margin="0,4,0,14"/>
                            <Border Style="{StaticResource CardBorder}">
                                <ItemsControl ItemsSource="{Binding SystemInfoPairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Style="{StaticResource Dim}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                           FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ CRASH DUMPS ============ -->
                <Grid Style="{StaticResource ViewRoot}"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVis}, ConverterParameter=dumps}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
                        <StackPanel MaxWidth="950" HorizontalAlignment="Left">
                            <Grid Margin="0,4,0,14">
                                <TextBlock Text="Crash Dump Analysis" Style="{StaticResource H1}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenDumpCommand}" Margin="0,0,8,0"
                                            ToolTip="Analyze a .dmp file copied from another computer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13"/>
                                            <TextBlock Text="Open dump file..." Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RescanDumpsCommand}" ToolTip="Rescan this machine for dumps">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                                            <TextBlock Text="Rescan" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="Overview" Style="{StaticResource H2}" Margin="8,0,0,0"/>
                                        <ProgressBar IsIndeterminate="True" Width="90" Height="3" Margin="14,0,0,0"
                                                     VerticalAlignment="Center" BorderThickness="0"
                                                     Background="#22FFFFFF" Foreground="{StaticResource Accent}"
                                                     Visibility="{Binding IsAnalyzingDumps, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DumpSummary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               FontSize="13.5" LineHeight="21"/>
                                    <ItemsControl ItemsSource="{Binding DumpNotes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12"
                                                               Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                                               Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Dumps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Panel}">
                                                            <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsKernel}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Style="{StaticResource Dim}" FontSize="11.5">
                                                                <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='dddd, dd MMMM yyyy  HH:mm'}"/><Run Text="   |   "/><Run Text="{Binding FileName, Mode=OneWay}"/><Run Text="   |   "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Dim}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>

                                                <TextBlock Text="What to do:" FontWeight="SemiBold" FontSize="12.5" Margin="0,10,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Resolutions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="6,2,0,0">
                                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                           Foreground="{StaticResource Good}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Dim}" Foreground="{StaticResource Fg}"
                                                                           FontSize="12.5" TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="820"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding ThirdPartyDrivers}" Margin="0,10,0,0"
                                                              Visibility="{Binding ThirdPartyDrivers.Count, Converter={StaticResource CountVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#20FFFFFF" CornerRadius="9" Padding="8,2" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Warn}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{Binding TechnicalDetails}" Style="{StaticResource Dim}"
                                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- busy overlay -->
                <Border Background="#900F1420" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="240" Height="4" BorderThickness="0"
                                     Background="#22FFFFFF" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================ status bar ================================ -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusBarInfo}" Style="{StaticResource Dim}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox IsChecked="{Binding AutoRefreshEnabled}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Live refresh" Style="{StaticResource Dim}" FontSize="11.5"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11.5" VerticalAlignment="Center">
                        <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text=" shown / "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" events"/>
                    </TextBlock>
                    <TextBlock Text="  |  " Style="{StaticResource Dim}" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11.5" VerticalAlignment="Center">
                        <Run Text="Last refresh: "/><Run Text="{Binding LastRefreshText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="  |  " Style="{StaticResource Dim}" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" FontSize="11.5"
                               VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
